# Copy to .env.local and fill with your key.
DEEPSEEK_API_KEY=
# Official API ID for DeepSeek-V4-Pro Preview.
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MAX_ATTEMPTS=10
DEEPSEEK_RETRY_BACKOFF_MAX=30

# Kimi K3 through the OpenAI-compatible Kimi Coding endpoint.
# Keep the identity truthful: it identifies this repository's coding agent.
KIMI_API_KEY=
KIMI_MODEL=k3[1m]
KIMI_BASE_URL=https://api.kimi.com/coding/v1
KIMI_CONTEXT_WINDOW=1048576
KIMI_MIN_GENERATION_TOKENS=32000
KIMI_MAX_GENERATION_TOKENS=98304
KIMI_REASONING_EFFORT=medium
KIMI_AGENT_IDENTITY=LiveOpt-Coding-Agent
KIMI_AGENT_VERSION=0.1.0
KIMI_USER_AGENT=LiveOpt-Coding-Agent/0.1.0
KIMI_MAX_RETRIES=2
KIMI_CACHE=1
KIMI_STREAM=1
KIMI_STREAM_PROGRESS=0
KIMI_STREAM_INCLUDE_USAGE=1
# Direct connection is the stable default. Set to 1 only when an explicit proxy is required.
KIMI_USE_SYSTEM_PROXY=0
